{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Console Hub",
  "version": "0.1.0",
  "identifier": "com.localconsolehub.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:24120",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Console Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
